{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/css/*",
      "/images/*.{png,jpg,jpeg,gif,svg}",
      "/*.css",
      "/*.ico",
      "/*.gif",
      "/*.js",
      "/*.json",
      "/*.jpeg",
      "/*.jpg",
      "/*.mjs",
      "/*.png",
      "/*.svg"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css",
    ".wasm": "application/wasm",
    ".json": "application/json"
  }
}